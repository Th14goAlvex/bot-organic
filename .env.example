# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser versionado.

# --- Discord ---
DISCORD_TOKEN=seu_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao
ALLOWED_CHANNEL_ID=id_do_canal_permitido
CANAL_STATUS_ID=id_do_canal_de_status
# Canal onde o bot avisa cada personagem novo criado e quantas vidas restam
CANAL_VIDAS_ID=id_do_canal_de_vidas
# Opcionais
# CANAL_MORTES_ID=
# CANAL_EVENTOS_ID=

# --- RCON do Project Zomboid ---
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=senha_do_rcon

# --- IA ---
GROQ_API_KEY=sua_chave_groq
GEMINI_API_KEY_1=sua_chave_gemini
# Opcionais: o bot faz rodizio entre as chaves disponiveis
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
