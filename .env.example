# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser versionado.

# --- Discord ---
DISCORD_TOKEN=seu_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao
ALLOWED_CHANNEL_ID=id_do_canal_permitido
CANAL_STATUS_ID=id_do_canal_de_status
# Canal onde o bot avisa cada personagem novo criado e quantas vidas restam
CANAL_VIDAS_ID=id_do_canal_de_vidas
# Opcionais
# CANAL_MORTES_ID=
# CANAL_EVENTOS_ID=

# --- RCON do Project Zomboid ---
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=senha_do_rcon

# --- IA ---
GROQ_API_KEY=sua_chave_groq
GEMINI_API_KEY_1=sua_chave_gemini
# Opcionais: o bot faz rodizio entre as chaves disponiveis
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# --- Call obrigatoria in-game ---
# Nome (ou parte dele) do canal de voz principal que conta como call in-game.
NOME_CALL_INGAME=in-game
# Alem da call in-game, essas calls oficiais tambem contam. Separe por virgula.
CANAIS_CALL_PERMITIDAS=Sala de espera,Atendimento 1,Atendimento 2,Atendimento 3,TRABALHANDO
# Quem sair de todas as calls permitidas tem este tempo para voltar antes do kick.
TEMPO_GRACA_CALL_INGAME=30
# Cargos do jogo que nunca sao expulsos, separados por virgula
CARGOS_ISENTOS_CALL=admin,moderator,moderador,overseer,gm,observer

# O mod ZomboidOSOnlinePlayersCSV B42.20 cria este arquivo (um username por linha).
# So altere se a host usar outro caminho dentro do cache do Project Zomboid.
# CAMINHO_MOD_PLAYERS_ONLINE=/caminho/para/FriendHost_Data/Servidor/online_players.txt
